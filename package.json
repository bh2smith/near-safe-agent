{
  "name": "near-safe-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"next dev --turbopack\" \"make-agent dev\"",
    "dev-testnet": "concurrently \"next dev --turbopack\" \"make-agent dev -t\"",
    "build": "next build",
    "deploy": "make-agent deploy -u https://near-safe-agent.vercel.app/",
    "start": "next start",
    "lint": "eslint {src,tests} && prettier --check '{src/app,tests}/**/*.{js,jsx,ts,tsx}'",
    "fmt": "eslint --fix {src,tests} && prettier --write '{src/app,tests}/**/*.{js,jsx,ts,tsx}'"
  },
  "dependencies": {
    "@bitte-ai/agent-sdk": "^0.4.1",
    "@safe-global/safe-core-sdk-utils": "^1.7.4",
    "near-safe": "0.12.1",
    "next": "^15.5.9",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "redoc": "^2.5.2",
    "vercel-url": "^0.2.8",
    "viem": "^2.43.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^15.5.9",
    "make-agent": "^0.4.1",
    "prettier": "^3.7.4",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  }
}
