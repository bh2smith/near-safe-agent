{
  "name": "near-safe-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"next dev --turbopack\" \"make-agent dev\"",
    "dev-testnet": "concurrently \"next dev --turbopack\" \"make-agent dev -t\"",
    "build": "next build",
    "deploy": "make-agent deploy -u https://near-safe-agent.vercel.app/",
    "start": "next start",
    "lint": "eslint {src,tests} && prettier --check '{src/app,tests}/**/*.{js,jsx,ts,tsx}'",
    "fmt": "eslint --fix {src,tests} && prettier --write '{src/app,tests}/**/*.{js,jsx,ts,tsx}'"
  },
  "dependencies": {
    "@bitte-ai/agent-sdk": "^0.4.1",
    "@safe-global/safe-core-sdk-utils": "^1.7.4",
    "near-safe": "0.12.0",
    "next": "^15.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "redoc": "^2.5.0",
    "vercel-url": "^0.2.8",
    "viem": "^2.37.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.36.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.2",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.3",
    "make-agent": "^0.4.1",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.4",
    "typescript": "^5.9.2"
  }
}
