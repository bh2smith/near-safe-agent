{
  "name": "near-safe-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "agent": "concurrently \"tsx src/index.ts\" \"make-agent dev\"",
    "api": "tsx src/index.ts",
    "build": "tsc",
    "deploy": "make-agent deploy -u https://near-safe-agent.vercel.app/",
    "lint": "eslint {src,tests}/**/*.ts && prettier --check '{src,tests}/**/*.{js,jsx,ts,tsx}'",
    "fmt": "eslint --fix {src,tests}/**/*.ts && prettier --write '{src,tests}/**/*.{js,jsx,ts,tsx}'"
  },
  "dependencies": {
    "@bitte-ai/agent-sdk": "^0.4.1",
    "@safe-global/safe-core-sdk-utils": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "near-safe": "0.12.0",
    "viem": "^2.37.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.36.0",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.2",
    "eslint": "^9.36.0",
    "make-agent": "^0.4.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
